<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="FolderMoveProtector.Settings.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!--
          Saving writes to HKEY_LOCAL_MACHINE, so this program always needs
          to run elevated. This manifest makes Windows show the UAC prompt
          automatically the moment it's launched, rather than failing partway
          through with an access-denied error.
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
